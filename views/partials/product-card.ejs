<%
  // The whole card (photo + name + button) leads to the piece's own page, where
  // the visitor orders it via WhatsApp/Instagram with the piece referenced.
  // Instagram + WhatsApp stay offered inline for quick questions.
  var productHref = href((product.category === 'bag' ? '/bags' : '/dolls') + '/' + product.slug);
  var ig = (product.instagramUrl && product.instagramUrl !== '#instagram-dm')
             ? product.instagramUrl : brand.instagramUrl;
  var hasWhatsapp = brand.whatsappUrl && brand.whatsappUrl !== '#whatsapp';
%>
<article class="card reveal">
  <a class="card__media" href="<%= productHref %>" aria-label="<%= product.name %>">
    <% if (product.image) { %>
      <img src="<%= product.image %>" alt="<%= product.name %>" loading="lazy" />
    <% } else { %>
      <div class="card__media-empty"><%= t.card.noImage %></div>
    <% } %>
  </a>
  <div class="card__body">
    <h3 class="card__name"><a class="card__name-link" href="<%= productHref %>"><%= product.name %></a></h3>
    <% if (product.priceCents > 0) { %>
      <p class="card__price"><%= formatPrice(product.priceCents, product.currency) %></p>
    <% } %>
    <p class="card__desc"><%= product.description %></p>

    <div class="card__actions">
      <a class="btn btn--sm" href="<%= productHref %>"><%= t.card.view %></a>
    </div>

    <p class="card__inquire">
      <%= t.card.questions %>
      <a href="<%= ig %>" target="_blank" rel="noopener">Instagram</a><% if (hasWhatsapp) { %>
      · <a href="<%= brand.whatsappUrl %>" target="_blank" rel="noopener">WhatsApp</a><% } %>
    </p>
  </div>
</article>
