# {{ ansible_managed }}
# Config for {{ app_name }}-backup (read by systemd EnvironmentFile). Contains the
# database credentials in DATABASE_URL — this file is root-only (0600).
DATABASE_URL={{ database_url }}
BACKUP_DIR={{ backup_dir }}
BACKUP_RETENTION_DAYS={{ backup_retention_days }}
BACKUP_REMOTE_ENABLED={{ backup_remote_enabled | bool | lower }}
BACKUP_REMOTE_HOST={{ backup_remote_host }}
BACKUP_REMOTE_USER={{ backup_remote_user }}
BACKUP_REMOTE_PATH={{ backup_remote_path }}
BACKUP_REMOTE_PORT={{ backup_remote_port }}
BACKUP_REMOTE_DELETE={{ backup_remote_delete | bool | lower }}
BACKUP_SSH_KEY={{ backup_ssh_key }}
